---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageContent = "<style>\n  .th-case-ctm__chartWrap {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n  }\n\n  .th-case-ctm__chartWrap canvas {\n    display: block;\n    width: 100% !important;\n    height: 100% !important;\n  }\n\n  .th-case-ctm__chartWrap--lg {\n    height: 540px;\n    min-height: 380px;\n  }\n\n  .th-case-ctm__chartWrap--md {\n    height: 420px;\n    min-height: 320px;\n  }\n\n  .th-case-ctm__chartWrap--sm {\n    height: 360px;\n    min-height: 300px;\n  }\n\n  @media (max-width: 700px) {\n    .th-case-ctm__chartWrap--lg {\n      height: 430px;\n    }\n\n    .th-case-ctm__chartWrap--md {\n      height: 360px;\n    }\n\n    .th-case-ctm__chartWrap--sm {\n      height: 320px;\n    }\n  }\n</style>\n\n<div class=\"portfolio-project-ctm\">\n  <div class=\"portfolio-project-ctm__inner\">\n\n    <header class=\"th-case-ctm__hero\">\n      <div class=\"th-case-ctm__heroTag\">Case Study / SEO / Content Strategy</div>\n      <h1>Tribal Habits: From directory dependency to owned search</h1>\n      <p class=\"th-case-ctm__heroSub\">\nHow a content-led SEO program shifted Tribal Habits' lead mix away from paid directories and built a channel the business owns permanently.\n &nbsp; &nbsp; &nbsp;</p>\n\n      <div class=\"th-case-ctm__metaGrid\">\n        <div class=\"th-case-ctm__metaItem\">\n          <div class=\"th-case-ctm__metaLabel\">Client</div>\n          <div class=\"th-case-ctm__metaValue\"><a href=\"https://tribalhabits.com/\" rel=\"noopener\" target=\"_blank\">Tribal Habits</a></div>\n        </div>\n        <div class=\"th-case-ctm__metaItem\">\n          <div class=\"th-case-ctm__metaLabel\">Industry</div>\n          <div class=\"th-case-ctm__metaValue\">Learning Management SaaS</div>\n        </div>\n        <div class=\"th-case-ctm__metaItem\">\n          <div class=\"th-case-ctm__metaLabel\">Market</div>\n          <div class=\"th-case-ctm__metaValue\">Australia &amp; New Zealand</div>\n        </div>\n        <div class=\"th-case-ctm__metaItem\">\n          <div class=\"th-case-ctm__metaLabel\">Duration</div>\n          <div class=\"th-case-ctm__metaValue\">18+ months</div>\n        </div>\n        <div class=\"th-case-ctm__metaItem\">\n          <div class=\"th-case-ctm__metaLabel\">Discipline</div>\n          <div class=\"th-case-ctm__metaValue\">SEO / Content Strategy / AEO</div>\n        </div>\n      </div>\n    </header>\n\n    <div class=\"th-case-ctm__quote\">\n      <div class=\"th-case-ctm__sectionLabel\">Updated August 2026</div>\n      <p>Four months on, the program continues to compound. Pages indexed have reached 1,000. Pages ranking in the top 10 have reached 436. Weekly search impressions are now around 30,000. Capterra has generated zero pipeline opportunities in the last 90 days.</p>\n      <div class=\"th-case-ctm__note\">Content rewriting, schema updates, and continued content maturation are ongoing — a further update is planned.</div>\n    </div>\n\n    <section class=\"th-case-ctm__stats\">\n      <div class=\"th-case-ctm__stat\">\n        <div class=\"th-case-ctm__statNum\">#1</div>\n        <div class=\"th-case-ctm__statLabel\">Organic search — top deal source since 2025</div>\n      </div>\n      <div class=\"th-case-ctm__stat\">\n        <div class=\"th-case-ctm__statNum\">40×</div>\n        <div class=\"th-case-ctm__statLabel\">Growth in weekly search impressions</div>\n      </div>\n      <div class=\"th-case-ctm__stat\">\n        <div class=\"th-case-ctm__statNum\">$128k</div>\n        <div class=\"th-case-ctm__statLabel\">Closed revenue from organic search since Jan 2025</div>\n      </div>\n      <div class=\"th-case-ctm__stat\">\n        <div class=\"th-case-ctm__statNum\">+172%</div>\n        <div class=\"th-case-ctm__statLabel\">Organic revenue growth vs prior period</div>\n      </div>\n    </section>\n\n    <div class=\"service-ctm__body th-case-ctm__body\">\n\n      <div class=\"th-case-ctm__sectionLabel\">The problem</div>\n      <h2>A business renting its leads</h2>\n      <p>When I came on board, Tribal Habits was heavily reliant on Capterra — a paid software directory — as a primary source of new business leads. On the surface, it was working. Leads were coming in. But the underlying risk was significant.</p>\n      <p>Paid directories offer no compounding value. You pay, you get leads. You stop paying, the leads stop. There's no equity being built, no channel the business owns, and no protection against Capterra changing its pricing, algorithm, or competitive dynamics. The business had no organic search presence worth speaking of — a critical vulnerability for a SaaS product in a category where buyers actively search before they buy.</p>\n\n      <div class=\"th-case-ctm__quote\">\n        <p>\"The goal wasn't just to rank. It was to build a lead channel Tribal Habits would own permanently — one that compounds rather than expires.\"</p>\n      </div>\n\n      <div class=\"th-case-ctm__compare\">\n        <div class=\"th-case-ctm__compareCol\">\n          <div class=\"th-case-ctm__compareLabel\">Before</div>\n          <ul>\n            <li>Capterra driving significant deal volume</li>\n            <li>Organic search underdeveloped</li>\n            <li>No AI search presence</li>\n            <li>Lead channel owned by a third party</li>\n            <li>Paid search running with no organic offset</li>\n          </ul>\n        </div>\n        <div class=\"th-case-ctm__compareCol th-case-ctm__compareCol--dark\">\n          <div class=\"th-case-ctm__compareLabel\">After</div>\n          <ul>\n            <li>Organic search — #1 deal source since 2025</li>\n            <li>Capterra no longer appears in last 90 days pipeline</li>\n            <li>AI referrals across 5 platforms generating pipeline</li>\n            <li>1,000 pages indexed, 436 in the top 10</li>\n            <li>$128k closed revenue from organic since Jan 2025</li>\n          </ul>\n        </div>\n      </div>\n\n      <hr>\n\n      <div class=\"th-case-ctm__sectionLabel\">The strategy</div>\n      <h2>Content architecture built around<br>\nbuyer pain points</h2>\n      <p>Rather than generic SEO content that could apply to any LMS provider, the program was built around the industries Tribal Habits actually serves — early learning, compliance, law firms, NFPs, &amp; professional services — with content that spoke directly to the operational and regulatory pain points each industry faces.</p>\n      <p>This meant rewriting industry landing pages from the ground up, then building a sustained blog program supporting each page with long-form content targeting the specific questions buyers were asking at each stage of the decision process.</p>\n\n      <div class=\"th-case-ctm__steps\">\n        <div class=\"th-case-ctm__step\">\n          <div class=\"th-case-ctm__stepNum\">1</div>\n          <div class=\"th-case-ctm__stepBody\">\n            <h3>Industry page architecture</h3>\n            <p>Rewrote core industry pages to lead with pain points, not product features. Each page built around the specific compliance, operational, and training challenges of that vertical.</p>\n          </div>\n        </div>\n        <div class=\"th-case-ctm__step\">\n          <div class=\"th-case-ctm__stepNum\">2</div>\n          <div class=\"th-case-ctm__stepBody\">\n            <h3>Content program at scale</h3>\n            <p>200+ blog posts targeting mid-funnel and bottom-funnel queries — comparison content, best practice guides, compliance explainers, and industry-specific training advice. Sustained over 18 months.</p>\n          </div>\n        </div>\n        <div class=\"th-case-ctm__step\">\n          <div class=\"th-case-ctm__stepNum\">3</div>\n          <div class=\"th-case-ctm__stepBody\">\n            <h3>AI search optimisation (AEO)</h3>\n            <p>Content structured for AI citation — clear direct answers, structured data elements, FAQ sections, and standalone extractable sections. The AI referral channel emerged as a by-product of good content architecture.</p>\n          </div>\n        </div>\n        <div class=\"th-case-ctm__step\">\n          <div class=\"th-case-ctm__stepNum\">4</div>\n          <div class=\"th-case-ctm__stepBody\">\n            <h3>Technical SEO foundation</h3>\n            <p>On-page optimisation, internal linking structure, and keyword mapping across the full content library to ensure each piece of content had a clear ranking target and supporting architecture.</p>\n          </div>\n        </div>\n      </div>\n\n      <hr>\n\n      <div class=\"th-case-ctm__sectionLabel\">The results</div>\n      <h2>A channel shift with commercial proof</h2>\n      <p>The results are tracked at pipeline and revenue level — not just traffic. This isn't a story about page views. It's a story about where deals actually come from.</p>\n\n      <div class=\"th-case-ctm__kpis\">\n        <div class=\"th-case-ctm__kpi\">\n          <div class=\"th-case-ctm__kpiNum\">31</div>\n          <div class=\"th-case-ctm__kpiLabel\">Pipeline opportunities from organic search in the last 90 days — Capterra: 0</div>\n        </div>\n        <div class=\"th-case-ctm__kpi\">\n          <div class=\"th-case-ctm__kpiNum\">$128k</div>\n          <div class=\"th-case-ctm__kpiLabel\">Closed revenue attributed to organic search since Jan 2025</div>\n        </div>\n        <div class=\"th-case-ctm__kpi\">\n          <div class=\"th-case-ctm__kpiNum\">436</div>\n          <div class=\"th-case-ctm__kpiLabel\">Pages ranking in the top 10 — up from 42 at program start</div>\n        </div>\n      </div>\n\n      <h3>Search visibility — program to date</h3>\n      <p>Weekly impressions grew from around 750 at program start to 25,000–38,000 by mid-2026 — a 40× increase in search visibility. Average position reached 8.9 in March 2026 before settling to around 13 as new content continued entering the index at scale. The site now has 1,000 pages indexed, up from 87 when the program began.</p>\n\n      <div class=\"th-case-ctm__chartCard\">\n        <div class=\"th-case-ctm__legend\">\n          <span><i style=\"background:#378ADD\"></i>Weekly impressions</span>\n          <span><i style=\"background:#00c853\"></i>Avg. position (right axis — lower is better)</span>\n        </div>\n        <div class=\"th-case-ctm__chartWrap th-case-ctm__chartWrap--lg\">\n          <canvas height=\"1082\" id=\"trendChart\" style=\"display: block; box-sizing: border-box; height: 541px; width: 1082px;\" width=\"2164\"></canvas>\n        </div>\n        <div class=\"th-case-ctm__note\">* Impressions spike Jul–Sep 2025 marks the content program hitting critical mass — a large volume of blog content entering the index simultaneously. Average position dipped temporarily as new pages ranked conservatively before building authority. The subsequent recovery reflects that content maturing.</div>\n      </div>\n\n      <h3>Pipeline by source — last 90 days</h3>\n      <p>In the last 90 days, organic search generated 31 pipeline opportunities. Capterra generated 0 — it no longer appears in the pipeline at all. AI search generated 6, continuing to grow as a standalone channel. In 2024, organic was third behind referrals and paid search at 37 deals. Since Jan 2025 it became the #1 source with 53 opportunities.</p>\n\n      <div class=\"th-case-ctm__chartCard\">\n        <div class=\"th-case-ctm__chartWrap th-case-ctm__chartWrap--md\">\n          <canvas height=\"1082\" id=\"pipelineChart\" style=\"display: block; box-sizing: border-box; height: 541px; width: 1082px;\" width=\"2164\"></canvas>\n        </div>\n        <div class=\"th-case-ctm__note\">Self-reported attribution — last 90 days pipeline opportunities.</div>\n      </div>\n\n      <h3>Position distribution — 1,000 pages</h3>\n      <p>436 pages now rank in the top 10 — up from 42 at program start, a 10× increase. A further 348 sit in positions 11–20. The program has grown the indexed page count from 87 to 1,000 and the top-10 count from 42 to 436.</p>\n\n      <div class=\"th-case-ctm__chartCard\">\n        <div class=\"th-case-ctm__chartWrap th-case-ctm__chartWrap--sm\">\n          <canvas height=\"1082\" id=\"positionChart\" style=\"display: block; box-sizing: border-box; height: 541px; width: 1082px;\" width=\"2164\"></canvas>\n        </div>\n      </div>\n\n      <h3>Traffic channels — Nov 2024 to Mar 2026</h3>\n      <p>Organic search accounts for 29% of all sessions over the full period. AI referrals have emerged as a distinct channel in the last 12 months — ChatGPT, Perplexity, Gemini, Claude, and Copilot are all sending referral traffic. This category didn't exist in the attribution data at the start of the program.</p>\n\n      <div class=\"th-case-ctm__chartGrid\">\n        <div class=\"th-case-ctm__chartCard\">\n          <div class=\"th-case-ctm__chartSub\">Sessions by channel</div>\n          <div class=\"th-case-ctm__legend\">\n            <span><i style=\"background:#888780\"></i>Direct 50%</span>\n            <span><i style=\"background:#378ADD\"></i>Organic 29%</span>\n            <span><i style=\"background:#4CAF50\"></i>Paid 10%</span>\n            <span><i style=\"background:#76C7B7\"></i>Referral 11%</span>\n            <span><i style=\"background:#BA7517\"></i>Capterra 6%</span>\n            <span><i style=\"background:#534AB7\"></i>AI 0.5%</span>\n          </div>\n          <div class=\"th-case-ctm__chartWrap th-case-ctm__chartWrap--md\">\n            <canvas height=\"1026\" id=\"channelChart\" style=\"display: block; box-sizing: border-box; height: 513px; width: 513px;\" width=\"1026\"></canvas>\n          </div>\n        </div>\n\n        <div class=\"th-case-ctm__chartCard\">\n          <div class=\"th-case-ctm__chartSub\">AI referral sources</div>\n          <div class=\"th-case-ctm__chartWrap th-case-ctm__chartWrap--md\">\n            <canvas height=\"756\" id=\"aiChart\" style=\"display: block; box-sizing: border-box; height: 378px; width: 513px;\" width=\"1026\"></canvas>\n          </div>\n        </div>\n      </div>\n\n      <h3>Summary<br><br></h3>\n      <table class=\"table-ctm th-case-ctm__table\">\n        <thead>\n          <tr>\n            <th>Metric</th>\n            <th>Start</th>\n            <th>Now</th>\n            <th>Change</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><td>Average search position</td><td>~27</td><td>~13 (peak 8.9, Mar 2026)</td><td>+52% improvement</td></tr>\n          <tr><td>Weekly impressions</td><td>~750</td><td>~30,000</td><td>40× growth</td></tr>\n          <tr><td>Pages indexed</td><td>87</td><td>1,000</td><td>11.5× growth</td></tr>\n          <tr><td>Pages ranking top 10</td><td>42</td><td>436</td><td>10× growth</td></tr>\n          <tr><td>Organic pipeline (2024)</td><td>37 deals — 3rd behind referrals &amp; paid</td><td>—</td><td>Historical baseline</td></tr>\n          <tr><td>Organic pipeline (since Jan 2025)</td><td>—</td><td>53 opportunities — #1 source</td><td>From 3rd to #1 channel</td></tr>\n          <tr><td>Organic pipeline (last 90 days)</td><td>—</td><td>31 opportunities — Capterra: 0</td><td>Complete channel shift</td></tr>\n          <tr><td>Organic closed revenue</td><td>$47,022 (pre-Jan 2025)</td><td>$128,097 (since Jan 2025)</td><td>+172%</td></tr>\n          <tr><td>Organic weighted pipeline</td><td>—</td><td>$163,584 (since Nov 2025)</td><td>#1 pipeline source</td></tr>\n          <tr><td>AI search pipeline</td><td>0</td><td>12 opportunities (since Nov 2025)</td><td>Net-new channel</td></tr>\n          <tr><td>AI referral platforms</td><td>0</td><td>5 platforms</td><td>Net-new channel</td></tr>\n        </tbody>\n      </table>\n\n      <br>\n      <hr>\n\n      <div class=\"th-case-ctm__sectionLabel\">AI visibility</div>\n      <h2>Recommended by four AI platforms — unprompted</h2>\n      <p>One of the clearest signals that a content program is working is when AI systems start recommending the business without being asked to. Search \"best Australian LMS?\" across the major AI platforms and Tribal Habits appears as a top recommendation in every one.</p>\n      <p>This isn't paid placement or an optimised prompt. It's the direct result of 18 months of content that AI systems have ingested, trusted, and cite when answering buyer questions. For a B2B SaaS product in a competitive category, this kind of AI visibility is now a meaningful part of the lead pipeline.</p>\n\n      <div class=\"th-case-ctm__aiGrid\">\n        <article class=\"th-case-ctm__aiCard\">\n          <div class=\"th-case-ctm__aiHead\">\n            <span class=\"th-case-ctm__aiDot\" style=\"background:#10a37f\"></span>\n            <span class=\"th-case-ctm__aiName\">ChatGPT</span>\n            <span class=\"th-case-ctm__aiBadge\">Top pick</span>\n          </div>\n          <div class=\"th-case-ctm__aiQuote\">\"For most Australian businesses, my pick is Tribal Habits.\"</div>\n          <img alt=\"ChatGPT recommending Tribal Habits as best Australian LMS\" class=\"th-case-ctm__aiImg\" src=\"/images/ChatGPT-AI_mentions.jpg\">\n        </article>\n\n        <article class=\"th-case-ctm__aiCard\">\n          <div class=\"th-case-ctm__aiHead\">\n            <span class=\"th-case-ctm__aiDot\" style=\"background:#4285f4\"></span>\n            <span class=\"th-case-ctm__aiName\">Google AI Overview</span>\n            <span class=\"th-case-ctm__aiBadge\">Featured</span>\n          </div>\n          <div class=\"th-case-ctm__aiQuote\">\"Best Overall for Internal Training: Tribal Habits.\"</div>\n          <img alt=\"Google AI Overview featuring Tribal Habits\" class=\"th-case-ctm__aiImg\" src=\"/images/Google-AI_mentions.jpg\">\n        </article>\n\n        <article class=\"th-case-ctm__aiCard\">\n          <div class=\"th-case-ctm__aiHead\">\n            <span class=\"th-case-ctm__aiDot\" style=\"background:#c84b2f\"></span>\n            <span class=\"th-case-ctm__aiName\">Claude</span>\n            <span class=\"th-case-ctm__aiBadge\">Top pick</span>\n          </div>\n          <div class=\"th-case-ctm__aiQuote\">\"Top Pick: Tribal Habits — go with Tribal Habits for the least friction and most Australian-relevant compliance content.\"</div>\n          <img alt=\"Claude recommending Tribal Habits as best Australian LMS\" class=\"th-case-ctm__aiImg\" src=\"/images/Claude-AI_mentions.jpg\">\n        </article>\n\n        <article class=\"th-case-ctm__aiCard\">\n          <div class=\"th-case-ctm__aiHead\">\n            <span class=\"th-case-ctm__aiDot\" style=\"background:#20b8cd\"></span>\n            <span class=\"th-case-ctm__aiName\">Perplexity</span>\n            <span class=\"th-case-ctm__aiBadge\">Top pick</span>\n          </div>\n          <div class=\"th-case-ctm__aiQuote\">\"If you're asking for the single best Australian LMS for a typical company, I'd start with Tribal Habits.\"</div>\n          <img alt=\"Perplexity recommending Tribal Habits as best Australian LMS\" class=\"th-case-ctm__aiImg\" src=\"/images/Perplexity-AI_mentions.jpg\">\n        </article>\n      </div>\n\n      <br>\n      <hr>\n\n      <div class=\"th-case-ctm__sectionLabel\">The takeaway</div>\n      <h2>Owned channels compound. Rented ones expire.</h2>\n      <p>A business that relies on paid directories for lead generation is building on rented ground. The moment the budget stops or the platform changes its dynamics, the pipeline dries up.</p>\n      <p>Organic search doesn't work that way. The 1,000 pages indexed on Tribal Habits' site don't stop ranking when the project ends. The 436 pages already in the top 10 will generate impressions and clicks next month without additional investment. Capterra hasn't generated a single pipeline opportunity in the last 90 days. That's the shift in full.</p>\n      <p>What I'm most proud of in this project isn't the position improvements or the impression growth — it's that the data shows a direct line from content strategy to closed revenue. That's the outcome that matters.</p>\n\n      <p>If you want the broader commercial framework behind this case, read <a href=\"/seo-for-saas-australia-what-works-in-2026/\">SEO for SaaS in Australia</a>, <a href=\"/from-traffic-to-demos-a-practical-funnel-for-b2b-saas/\">From Traffic to Demos: The Practical B2B Funnel</a>, and <a href=\"/b2b-saas-demo-request-landing-page-benchmarks/\">B2B SaaS Demo Request Landing Page Benchmarks</a>.</p>\n\n      <div class=\"th-case-ctm__cta\">\n        <h2>Want to build a channel you own?</h2>\n        <p>I work with B2B companies to build content-led SEO programs that compound over time. Get in touch to talk through your situation.</p>\n        <p>See how I deliver this for software brands with <a href=\"/seo-for-saas-startups/\">SEO for SaaS &amp; startups</a>, or check <a href=\"/pricing-and-packages/\">pricing and packages</a>.</p>\n        <a href=\"/contact-form/\"><span class=\"custom-btn\">Get in touch</span></a>\n      </div>\n\n      <br>\n\n      <div class=\"portfolio-project-ctm__link\">\n        <a href=\"https://tribalhabits.com/\" rel=\"noopener\" target=\"_blank\">tribalhabits.com</a>\n      </div>\n\n      <br>\n\n      <div class=\"portfolio-project-ctm__footer\">\n        <a class=\"portfolio-project-ctm__back\" href=\"/portfolio-1/\">Back to Portfolio</a>\n      </div>\n\n      <div class=\"portfolio-project-ctm__nav\">\n        <a class=\"portfolio-project-ctm__nav-item portfolio-project-ctm__nav-item--prev\" href=\"/archive/\">\n          <span class=\"portfolio-project-ctm__nav-label\">Previous Project</span>\n          <span class=\"portfolio-project-ctm__nav-title\">Archive</span>\n        </a>\n        <a class=\"portfolio-project-ctm__nav-item portfolio-project-ctm__nav-item--next\" href=\"/kryoz/\" rel=\"history\">\n          <span class=\"portfolio-project-ctm__nav-label\">Next Project</span>\n          <span class=\"portfolio-project-ctm__nav-title\">Kryoz</span>\n        </a>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js\"></script>\n<script>\n(function () {\n  let thChartsStarted = false;\n\n  function initTHCharts() {\n    if (thChartsStarted) return;\n    if (typeof Chart === 'undefined') {\n      console.warn('Chart.js not loaded yet');\n      return;\n    }\n\n    const required = ['trendChart', 'pipelineChart', 'positionChart', 'channelChart', 'aiChart'];\n    const foundAny = required.some(id => document.getElementById(id));\n    if (!foundAny) {\n      console.warn('No chart canvases found');\n      return;\n    }\n\n    thChartsStarted = true;\n\n    const tcm = 'rgba(0,200,83,.72)';\n    const gc = 'rgba(0,200,83,.14)';\n\n    const storePlugin = {\n      id: 'storeAnnotation',\n      beforeDraw(chart) {\n        const { ctx, chartArea, scales } = chart;\n        if (!chartArea || !scales || !scales.x) return;\n        const x1 = scales.x.getPixelForValue(31);\n        const x2 = scales.x.getPixelForValue(40);\n        if (!isFinite(x1) || !isFinite(x2)) return;\n        ctx.save();\n        ctx.fillStyle = 'rgba(186,117,23,0.10)';\n        ctx.fillRect(x1, chartArea.top, x2 - x1, chartArea.height);\n        ctx.fillStyle = 'rgba(186,117,23,0.8)';\n        ctx.font = '10px sans-serif';\n        ctx.fillText('*', x1 + 4, chartArea.top + 14);\n        ctx.restore();\n      }\n    };\n\n    const weeks = [\"Nov 25\",\"Dec 2\",\"Dec 9\",\"Dec 16\",\"Dec 23\",\"Dec 30\",\"Jan 6\",\"Jan 13\",\"Jan 20\",\"Jan 27\",\"Feb 3\",\"Feb 10\",\"Feb 17\",\"Feb 24\",\"Mar 3\",\"Mar 10\",\"Mar 17\",\"Mar 24\",\"Mar 31\",\"Apr 7\",\"Apr 14\",\"Apr 21\",\"Apr 28\",\"May 5\",\"May 12\",\"May 19\",\"May 26\",\"Jun 2\",\"Jun 9\",\"Jun 16\",\"Jun 23\",\"Jun 30\",\"Jul 7\",\"Jul 14\",\"Jul 21\",\"Jul 28\",\"Aug 4\",\"Aug 11\",\"Aug 18\",\"Aug 25\",\"Sep 1\",\"Sep 8\",\"Sep 15\",\"Sep 22\",\"Sep 29\",\"Oct 6\",\"Oct 13\",\"Oct 20\",\"Oct 27\",\"Nov 3\",\"Nov 10\",\"Nov 17\",\"Nov 24\",\"Dec 1\",\"Dec 8\",\"Dec 15\",\"Dec 22\",\"Dec 29\",\"Jan 5\",\"Jan 12\",\"Jan 19\",\"Jan 26\",\"Feb 2\",\"Feb 9\",\"Feb 16\",\"Feb 23\",\"Mar 2\",\"Mar 9\",\"Mar 16\",\"Mar 23\",\"Mar 30\",\"Apr 6\",\"Apr 13\",\"Apr 20\",\"Apr 27\",\"May 4\",\"May 11\",\"May 18\",\"May 25\",\"Jun 1\",\"Jun 8\",\"Jun 15\",\"Jun 22\",\"Jun 29\",\"Jul 6\",\"Jul 13\",\"Jul 20\",\"Jul 27\"];\n\n    const impressions = [556,2291,2399,1350,655,1233,2184,1767,1920,2412,3165,2819,2977,2981,3643,3314,2993,3005,3023,3033,2130,2384,2791,3112,2932,2778,2857,2864,3206,2683,2683,6492,8158,9024,9013,8343,9096,10458,9292,8584,9503,6444,3480,3180,3076,3524,3801,4044,4398,4123,4525,4740,4498,5016,5745,5431,4114,4320,6461,6855,5779,7052,5863,6739,7289,6651,6372,6554,6538,6088,5179,5939,5755,5736,6245,6440,34777,37978,31777,29617,29313,31835,31442,30896,29879,27082,25876,25805];\n\n    const positions = [16.1,17.6,15.6,13.2,15.8,17.6,17.3,9.9,11.6,10.9,15.4,8.7,9.6,11.1,17.5,12.2,12.3,12.5,16.0,18.1,21.3,20.3,18.1,18.6,19.7,16.6,17.7,19.6,21.0,18.3,16.5,31.0,35.3,35.7,37.5,37.9,37.7,38.5,37.6,38.1,37.1,27.1,17.4,16.6,18.6,16.6,17.2,17.7,16.2,15.2,14.0,13.5,16.2,18.0,20.4,21.2,24.7,23.1,19.9,19.9,20.2,18.6,15.1,15.2,12.8,13.9,10.4,11.0,10.7,10.6,11.2,11.0,11.3,11.8,12.4,11.7,13.3,15.8,13.4,11.6,12.3,13.3,14.6,13.2,13.4,13.4,13.5,15.9];\n\n    function buildChart(id, config) {\n      const el = document.getElementById(id);\n      if (!el) return;\n      const existing = Chart.getChart(el);\n      if (existing) existing.destroy();\n      new Chart(el.getContext('2d'), config);\n    }\n\n    buildChart('trendChart', {\n      data: {\n        labels: weeks,\n        datasets: [\n          { type: 'bar', label: 'Impressions', data: impressions, backgroundColor: 'rgba(55,138,221,0.42)', borderRadius: 2, yAxisID: 'y' },\n          { type: 'line', label: 'Position', data: positions, borderColor: '#00c853', backgroundColor: 'transparent', borderWidth: 2, pointRadius: 0, tension: 0.35, yAxisID: 'y2' }\n        ]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        animation: false,\n        plugins: { legend: { display: false } },\n        scales: {\n          x: {\n            ticks: { color: tcm, font: { size: 10 }, maxRotation: 45, autoSkip: true, maxTicksLimit: 18 },\n            grid: { color: gc }\n          },\n          y: {\n            ticks: { color: tcm, font: { size: 10 }, callback: v => v >= 1000 ? (v/1000).toFixed(0)+'k' : v },\n            grid: { color: gc }\n          },\n          y2: {\n            position: 'right',\n            reverse: true,\n            min: 0,\n            max: 45,\n            ticks: { color: tcm, font: { size: 10 }, callback: v => 'Pos ' + v },\n            grid: { display: false }\n          }\n        }\n      },\n      plugins: [storePlugin]\n    });\n\n    buildChart('pipelineChart', {\n      type: 'bar',\n      data: {\n        labels: ['Organic search','AI search','Referral','Sector webinar','Client referral','Past client','(No value)','AHRI','Google Ads'],\n        datasets: [{\n          data: [31,6,5,3,2,2,1,1,1],\n          backgroundColor: ['#378ADD','#534AB7','#888780','#BA7517','#1D9E75','#5DCAA5','#B4B2A9','#76C7B7','#c84b2f'],\n          borderRadius: 4\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        animation: false,\n        indexAxis: 'y',\n        plugins: { legend: { display: false } },\n        scales: {\n          x: { ticks: { color: tcm, font: { size: 10 } }, grid: { color: gc } },\n          y: { ticks: { color: tcm, font: { size: 11 } }, grid: { display: false } }\n        }\n      }\n    });\n\n    buildChart('positionChart', {\n      type: 'bar',\n      data: {\n        labels: ['Top 3', 'Positions 4–10', 'Positions 11–20', 'Positions 21+'],\n        datasets: [{\n          data: [18,418,348,216],\n          backgroundColor: ['#378ADD','#1D9E75','#BA7517','rgba(0,200,83,.18)'],\n          borderRadius: 4\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        animation: false,\n        plugins: { legend: { display: false } },\n        scales: {\n          x: { ticks: { color: tcm, font: { size: 12 } }, grid: { display: false } },\n          y: { ticks: { color: tcm, font: { size: 10 } }, grid: { color: gc } }\n        }\n      }\n    });\n\n    buildChart('channelChart', {\n      type: 'doughnut',\n      data: {\n        labels: ['Direct','Organic search','Paid','Other referral','Capterra','AI referrals'],\n        datasets: [{\n          data: [22425,13097,4521,4805,2737,234],\n          backgroundColor: ['#888780','#378ADD','#4CAF50','#76C7B7','#BA7517','#534AB7'],\n          borderWidth: 2,\n          borderColor: '#ffffff'\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        animation: false,\n        cutout: '62%',\n        plugins: { legend: { display: false } }\n      }\n    });\n\n    buildChart('aiChart', {\n      type: 'bar',\n      data: {\n        labels: ['ChatGPT','Perplexity','Gemini','Claude.ai','Copilot'],\n        datasets: [{\n          data: [174,35,12,8,5],\n          backgroundColor: ['#534AB7','#c84b2f','#378ADD','#1D9E75','#888780'],\n          borderRadius: 4\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        animation: false,\n        plugins: { legend: { display: false } },\n        scales: {\n          x: { ticks: { color: tcm, font: { size: 11 } }, grid: { display: false } },\n          y: { ticks: { color: tcm, font: { size: 10 } }, grid: { color: gc } }\n        }\n      }\n    });\n  }\n\n  function startWhenReady() {\n    if (typeof Chart !== 'undefined') {\n      initTHCharts();\n      return;\n    }\n\n    let tries = 0;\n    const timer = setInterval(function () {\n      tries += 1;\n      if (typeof Chart !== 'undefined') {\n        clearInterval(timer);\n        initTHCharts();\n      } else if (tries > 40) {\n        clearInterval(timer);\n        console.error('Chart.js never became available');\n      }\n    }, 150);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', startWhenReady);\n  } else {\n    startWhenReady();\n  }\n\n  window.addEventListener('load', startWhenReady);\n})();\n</script>";

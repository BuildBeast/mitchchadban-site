igr-case-study__principles strong,.digr-case-study__principles span{display:block}.digr-case-study__principles strong{margin-bottom:12px;font-size:1rem}.digr-case-study__principles span{font-size:.95rem;line-height:1.4;opacity:.72}.digr-case-study__rule{padding:30px!important;background:#171717;color:#f4f2e9;border-radius:18px;border-bottom:0!important}.digr-case-study__rule .digr-case-study__kicker{color:#b6ff24;opacity:1}.digr-case-study__next ul{padding-left:1.2em;margin:24px 0}.digr-case-study__next li{margin-bottom:8px}@media(max-width:800px){.digr-case-study__body{grid-template-columns:1fr;gap:12px}.digr-case-study__side{position:static;order:-1;grid-template-columns:repeat(2,1fr);margin-bottom:44px}.digr-case-study__principles{grid-template-columns:1fr}.digr-case-study__system-top,.digr-case-study__system-bottom{flex-wrap:wrap}}@media(max-width:500px){.digr-case-study__side{grid-template-columns:1fr}.digr-case-study__system{border-radius:14px}}

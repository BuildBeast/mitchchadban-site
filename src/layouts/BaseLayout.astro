---
import '../styles/cargo.css';
import '../styles/migration-overrides.css';
import CargoHeader from '../components/CargoHeader.astro';
import CargoFooter from '../components/CargoFooter.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

type Alternate = { lang: string; href: string };

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  lang?: string;
  noindex?: boolean;
  alternates?: Alternate[];
};

const {
  title = 'Mitch Chadban | Design, SEO and Marketing Services Australia',
  description = 'Design, SEO and marketing for brands, SaaS companies and service businesses that need sharper websites, stronger content and cleaner growth systems.',
  canonical,
  ogImage = 'https://mitchchadban.com/images/og-default.jpg',
  ogType = 'website',
  lang = 'en-AU',
  noindex = false,
  alternates = []
} = Astro.props;

// Canonical: explicit prop wins. Otherwise derive it from the current route so a
// page without an explicit canonical points at itself, not at the homepage.
// Root stays "/", every other route gets the trailing-slash form.
const canonicalPath =
  Astro.url.pathname === '/'
    ? '/'
    : `${Astro.url.pathname.replace(/\/+$/, '')}/`;

const resolvedCanonical =
  canonical ?? new URL(canonicalPath, 'https://mitchchadban.com').href;

// Ensure absolute URL for OG image
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, 'https://mitchchadban.com').href;

// Site-wide entity graph: WebSite + Person (Mitch Chadban), connected via stable @id.
// sameAs lists only confirmed public profiles already present in site config.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://mitchchadban.com/#website',
      url: 'https://mitchchadban.com/',
      name: 'Mitch Chadban',
      description:
        'Design, SEO and marketing for brands, SaaS companies and service businesses that need sharper websites, stronger content and cleaner growth systems.',
      publisher: { '@id': 'https://mitchchadban.com/#person' },
      inLanguage: lang
    },
    {
      '@type': 'Person',
      '@id': 'https://mitchchadban.com/#person',
      name: 'Mitch Chadban',
      url: 'https://mitchchadban.com/',
      jobTitle: 'Designer, SEO & Marketing Specialist',
      sameAs: ['https://www.instagram.com/mitch_chadban/?hl=en']
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H2XPB49M37"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-H2XPB49M37');
    </script>

    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Mitch Chadban" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <slot name="head" />
    <script is:inline defer src="/scripts-cursor.js"></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <CargoHeader lang={lang} />

    <main id="main">
      <slot />
    </main>

    <CargoFooter lang={lang} />

    <SpeedInsights />
    <Analytics />
  </body>
</html>
